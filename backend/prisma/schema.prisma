// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  firstName      String?
  lastName       String?
  role           String    @default("visitador") // admin, visitador
  active         Boolean   @default(true)
  calendarToken  String?   @unique
  churchId       Int
  church         Church    @relation("UserHomeChurch", fields: [churchId], references: [id])
  accessChurches Church[]  @relation("UserChurchAccess")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  contacts       Contact[]
  visits         VisitSchedule[]
  sermons        PreachingSchedule[]
  suggestionsFor MessageSuggestion[]
  tasks          Task[]
  prayerRequests PrayerRequest[]

  @@map("users")
}

model Church {
  id       Int       @id @default(autoincrement())
  name     String
  location String?
  members  Member[]
  users    User[]    @relation("UserHomeChurch")
  usersWithAccess User[] @relation("UserChurchAccess")
  preachings PreachingSchedule[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("churches")
}

model Member {
  id            Int       @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  status        String?   // espiritual, visitante, inactivo, etc
  lastContact   DateTime?
  lastVisit     DateTime?
  notes         String?
  messageSuggested Boolean @default(false) // ya sugerido o contactado en el ciclo actual
  photo            String?   // base64 comprimido, generado en el navegador
  address          String?
  birthDate        DateTime?
  baptismDate      DateTime?
  ministries       String?
  responsibilities String?
  interests        String?
  characteristics  String?   // cualidades, aptitudes y actitudes espirituales, en texto libre
  followUpLevel    String    @default("normal") // normal, prioritario, urgente
  nextAction       String?
  churchId      Int
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  families      Family[]
  needs         Need[]
  contacts      Contact[]
  visits        VisitSchedule[]
  suggestions   MessageSuggestion[]
  tags          Tag[]     @relation("MemberTags")
  tasks         Task[]
  prayerRequests PrayerRequest[]
  familyGroupId Int?
  familyGroup   FamilyGroup? @relation(fields: [familyGroupId], references: [id])

  @@map("members")
}

model FamilyGroup {
  id        Int      @id @default(autoincrement())
  members   Member[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("family_groups")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String?
  members   Member[] @relation("MemberTags")
  createdAt DateTime @default(now())

  @@map("tags")
}

model Family {
  id        Int       @id @default(autoincrement())
  memberId  Int
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  relation  String?   // esposa, hijo, etc
  name      String
  dob       DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("families")
}

model Need {
  id        Int       @id @default(autoincrement())
  memberId  Int
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  description String
  priority  String?   // baja, media, alta
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("needs")
}

model Contact {
  id        Int       @id @default(autoincrement())
  memberId  Int
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      String    // visita, llamada, mensaje
  date      DateTime
  notes     String?
  contactBy Int
  user      User      @relation(fields: [contactBy], references: [id])
  viaSms    Boolean   @default(false)
  viaEmail  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("contacts")
}

model VisitSchedule {
  id            Int       @id @default(autoincrement())
  memberId      Int
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type          String    @default("visita") // visita, llamada, mensaje
  scheduledDate DateTime
  status        String    @default("pendiente") // pendiente, completada, cancelada
  notes         String?
  outcome       String?   // solo llamadas: contactado, no-respondio, solicita-visita, necesita-oracion, requiere-seguimiento, situacion-resuelta, otro
  topics        String?   // temas tratados / observaciones del cierre
  commitments   String?   // compromisos asumidos
  assignedTo    Int
  user          User      @relation(fields: [assignedTo], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  followUpTasks Task[]

  @@map("visit_schedule")
}

model Task {
  id             Int       @id @default(autoincrement())
  memberId       Int
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type           String    // volver-a-visitar, llamar, enviar-material, coordinar-ayuda, contactar-anciano, orar, personalizada
  description    String?
  dueDate        DateTime?
  status         String    @default("pendiente") // pendiente, completada
  relatedVisitId Int?
  relatedVisit   VisitSchedule? @relation(fields: [relatedVisitId], references: [id], onDelete: SetNull)
  assignedTo     Int
  user           User      @relation(fields: [assignedTo], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("tasks")
}

model PrayerRequest {
  id          Int       @id @default(autoincrement())
  memberId    Int
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  description String
  scheduledAt DateTime? // fecha/hora opcional para orar
  status      String    @default("activo") // activo, contestada, caducada
  assignedTo  Int
  user        User      @relation(fields: [assignedTo], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("prayer_requests")
}

model MessageSuggestion {
  id        Int      @id @default(autoincrement())
  dateKey   String   // "YYYY-MM-DD" en hora de Rep. Dominicana
  userId    Int      // para quién es esta sugerencia (cada usuario tiene su propia lista)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sentAt    DateTime? // cuándo se marcó "enviado" (null = todavía pendiente)
  createdAt DateTime @default(now())

  @@map("message_suggestions")
}

model MessageTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   // bienvenida, seguimiento, oracion, cumpleanos, invitacion, otro
  body      String   // texto con variable {nombre}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

model PreachingSchedule {
  id        Int       @id @default(autoincrement())
  date      DateTime
  title     String
  location  String?
  churchId  Int
  church    Church    @relation(fields: [churchId], references: [id])
  assignedTo Int
  user      User      @relation(fields: [assignedTo], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("preaching_schedule")
}
