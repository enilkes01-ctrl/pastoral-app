# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pastoral_app"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Email (SendGrid)
SENDGRID_API_KEY="your-sendgrid-key"

# Calendar (Google)
GOOGLE_CALENDAR_KEY="your-google-calendar-key"

# Seed inicial (churches y usuario admin)
SEED_CHURCH_NAMES="Alma Rosa Central,Luz de Alma Rosa,Luz de Cristo"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
